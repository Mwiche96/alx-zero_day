   "source": [
    "## Step 5: Voltage-Based Color Coding for Transmission Lines\n",
    "\n",
    "Setting up color coding based on voltage levels for better visualization."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def assign_voltage_colors(transmission_lines):\n",
    "    \"\"\"\n",
    "    Assign colors to transmission lines based on voltage levels.\n",
    "    \"\"\"\n",
    "    print(\"Assigning colors based on voltage levels...\")\n",
    "    \n",
    "    # Define voltage color mapping (high contrast for light theme)\n",
    "    voltage_colors = {\n",
    "        '330000': '#FF0000',  # Red - High voltage\n",
    "        '220000': '#FF6600',  # Orange-Red\n",
    "        '132000': '#FF9900',  # Orange\n",
    "        '88000': '#0066CC',   # Blue\n",
    "        '66000': '#0099FF',   # Light Blue\n",
    "        '33000': '#00CC66',   # Green\n",
    "        '22000': '#66CC00',   # Light Green\n",
    "        '11000': '#999999',   # Gray\n",
    "        'unknown': '#333333'  # Dark Gray\n",
    "    }\n",
    "    \n",
    "    # Clean voltage values and assign colors\n",
    "    lines = transmission_lines.copy()\n",
    "    lines['voltage_clean'] = lines['voltage'].astype(str)\n",
    "    \n",
    "    # Extract numeric voltage values\n",
    "    def clean_voltage(voltage_str):\n",
    "        if pd.isna(voltage_str) or voltage_str == 'unknown':\n",
    "            return 'unknown'\n",
    "        \n",
    "        # Extract numbers and handle common formats\n",
    "        voltage_str = str(voltage_str).replace('kV', '000').replace('V', '')\n",
    "        \n",
    "        # Find the highest voltage if multiple values\n",
    "        import re\n",
    "        numbers = re.findall(r'\\d+', voltage_str)\n",
    "        if numbers:\n",
    "            max_voltage = max([int(x) for x in numbers])\n",
    "            # Round to nearest standard voltage\n",
    "            standard_voltages = [330000, 220000, 132000, 88000, 66000, 33000, 22000, 11000]\n",
    "            closest = min(standard_voltages, key=lambda x: abs(x - max_voltage))\n",
    "            return str(closest)\n",
    "        return 'unknown'\n",
    "    \n",
    "    lines['voltage_clean'] = lines['voltage'].apply(clean_voltage)\n",
    "    lines['color'] = lines['voltage_clean'].map(voltage_colors)\n",
    "    \n",
    "    # Print voltage distribution\n",
    "    voltage_counts = lines['voltage_clean'].value_counts()\n",
    "    print(\"Voltage level distribution:\")\n",
    "    for voltage, count in voltage_counts.items():\n",
    "        color = voltage_colors.get(voltage, '#000000')\n",
    "        print(f\"  {voltage}V: {count} lines (color: {color})\")\n",
    "    \n",
    "    return lines, voltage_colors\n",
    "\n",
    "# Assign colors to transmission lines\n",
    "transmission_lines_colored, voltage_color_map = assign_voltage_colors(transmission_lines)"
   ]
  },
