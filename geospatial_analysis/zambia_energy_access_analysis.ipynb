    "## Step 2: Extract Transmission Lines from OpenStreetMap\n",
    "\n",
    "Using the Overpass API to extract transmission lines data for Zambia with voltage information."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_transmission_lines():\n",
    "    \"\"\"\n",
    "    Extract transmission lines from OpenStreetMap for Zambia using Overpass API.\n",
    "    \"\"\"\n",
    "    print(\"Extracting transmission lines from OpenStreetMap...\")\n",
    "    \n",
    "    api = overpy.Overpass()\n",
    "    \n",
    "    # Overpass query for transmission lines in Zambia\n",
    "    # Note: bbox format is (south,west,north,east)\n",
    "    query = \"\"\"\n",
    "    [out:json][timeout:60];\n",
    "    (\n",
    "        way[\"power\"=\"line\"][\"voltage\"](bbox:-18.5,21.5,-8.5,34.0);\n",
    "        relation[\"power\"=\"line\"][\"voltage\"](bbox:-18.5,21.5,-8.5,34.0);\n",
    "    );\n",
    "    out geom;\n",
    "    \"\"\"\n",
    "    \n",
    "    try:\n",
    "        result = api.query(query)\n",
    "        print(f\"Found {len(result.ways)} transmission lines\")\n",
    "        \n",
    "        # Convert to GeoDataFrame\n",
    "        lines_data = []\n",
    "        \n",
    "        for way in result.ways:\n",
    "            coords = [(node.lon, node.lat) for node in way.nodes]\n",
    "            if len(coords) >= 2:\n",
    "                voltage = way.tags.get('voltage', 'unknown')\n",
    "                lines_data.append({\n",
    "                    'geometry': LineString(coords),\n",
    "                    'voltage': voltage,\n",
    "                    'id': way.id\n",
    "                })\n",
    "        \n",
    "        if lines_data:\n",
    "            gdf_lines = gpd.GeoDataFrame(lines_data, crs='EPSG:4326')\n",
    "            print(f\"Created GeoDataFrame with {len(gdf_lines)} transmission lines\")\n",
    "            return gdf_lines\n",
    "        else:\n",
    "            print(\"No transmission lines found, creating sample data...\")\n",
    "            return create_sample_transmission_lines()\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"Error querying OpenStreetMap: {e}\")\n",
    "        print(\"Creating sample transmission lines data...\")\n",
    "        return create_sample_transmission_lines()\n",
    "\n",
    "def create_sample_transmission_lines():\n",
    "    \"\"\"\n",
    "    Create sample transmission lines data for demonstration.\n",
    "    \"\"\"\n",
    "    print(\"Creating sample transmission lines...\")\n",
    "    \n",
    "    # Sample transmission lines connecting major cities in Zambia\n",
    "    lines_data = [\n",
    "        {\n",
    "            'geometry': LineString([(28.3, -15.4), (30.2, -14.8), (31.5, -12.8)]),\n",
    "            'voltage': '330000',\n",
    "            'id': 1\n",
    "        },\n",
    "        {\n",
    "            'geometry': LineString([(28.3, -15.4), (26.8, -14.2), (25.9, -13.1)]),\n",
    "            'voltage': '220000',\n",
    "            'id': 2\n",
    "        },\n",
    "        {\n",
    "            'geometry': LineString([(30.2, -14.8), (29.1, -13.5), (28.2, -12.1)]),\n",
    "            'voltage': '132000',\n",
    "            'id': 3\n",
    "        },\n",
    "        {\n",
    "            'geometry': LineString([(26.2, -17.8), (28.3, -15.4), (29.8, -13.9)]),\n",
    "            'voltage': '330000',\n",
    "            'id': 4\n",
    "        },\n",
    "        {\n",
    "            'geometry': LineString([(24.8, -16.2), (26.5, -15.1), (28.1, -14.3)]),\n",
    "            'voltage': '88000',\n",
    "            'id': 5\n",
    "        }\n",
    "    ]\n",
    "    \n",
    "    gdf_lines = gpd.GeoDataFrame(lines_data, crs='EPSG:4326')\n",
    "    print(f\"Created sample transmission lines: {len(gdf_lines)} lines\")\n",
    "    return gdf_lines\n",
    "\n",
    "# Get transmission lines data\n",
    "transmission_lines = get_transmission_lines()\n",
    "print(f\"\\nVoltage levels found: {transmission_lines['voltage'].unique()}\")"
   ]
  },
