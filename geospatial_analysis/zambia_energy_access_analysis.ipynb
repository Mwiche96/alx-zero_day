    "## Step 1: Download Population Density Data from WorldPop\n",
    "\n",
    "We'll download the population density raster data for Zambia from WorldPop."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def download_worldpop_data():\n",
    "    \"\"\"\n",
    "    Download population density data for Zambia from WorldPop.\n",
    "    For this example, we'll use a sample URL - in practice, you would get the specific\n",
    "    URL from the WorldPop website for Zambia's latest population density data.\n",
    "    \"\"\"\n",
    "    # Sample WorldPop URL for Zambia (2020 population density)\n",
    "    # Note: This is a placeholder URL - actual URLs would be obtained from worldpop.org\n",
    "    worldpop_url = \"https://data.worldpop.org/GIS/Population/Global_2000_2020/2020/ZMB/zmb_ppp_2020_1km_Aggregated.tif\"\n",
    "    \n",
    "    output_file = \"zambia_population_density.tif\"\n",
    "    \n",
    "    if not os.path.exists(output_file):\n",
    "        print(f\"Downloading population density data for Zambia...\")\n",
    "        try:\n",
    "            response = requests.get(worldpop_url, stream=True)\n",
    "            if response.status_code == 200:\n",
    "                with open(output_file, 'wb') as f:\n",
    "                    for chunk in response.iter_content(chunk_size=8192):\n",
    "                        f.write(chunk)\n",
    "                print(f\"Downloaded: {output_file}\")\n",
    "            else:\n",
    "                print(f\"Failed to download data. Status code: {response.status_code}\")\n",
    "                # For demonstration, we'll create a synthetic dataset\n",
    "                create_synthetic_population_data()\n",
    "        except Exception as e:\n",
    "            print(f\"Error downloading data: {e}\")\n",
    "            print(\"Creating synthetic population data for demonstration...\")\n",
    "            create_synthetic_population_data()\n",
    "    else:\n",
    "        print(f\"Population data already exists: {output_file}\")\n",
    "    \n",
    "    return output_file\n",
    "\n",
    "def create_synthetic_population_data():\n",
    "    \"\"\"\n",
    "    Create synthetic population density data for Zambia for demonstration purposes.\n",
    "    \"\"\"\n",
    "    print(\"Creating synthetic population density data for demonstration...\")\n",
    "    \n",
    "    # Zambia approximate bounds\n",
    "    min_lon, max_lon = 21.5, 34.0\n",
    "    min_lat, max_lat = -18.5, -8.5\n",
    "    \n",
    "    # Create synthetic population density data\n",
    "    width, height = 200, 150\n",
    "    \n",
    "    # Generate realistic population distribution\n",
    "    np.random.seed(42)\n",
    "    x = np.linspace(0, 1, width)\n",
    "    y = np.linspace(0, 1, height)\n",
    "    X, Y = np.meshgrid(x, y)\n",
    "    \n",
    "    # Create population centers (cities)\n",
    "    centers = [(0.3, 0.7), (0.6, 0.4), (0.8, 0.8), (0.2, 0.3)]  # Lusaka, Kitwe, etc.\n",
    "    population = np.zeros((height, width))\n",
    "    \n",
    "    for cx, cy in centers:\n",
    "        dist = np.sqrt((X - cx)**2 + (Y - cy)**2)\n",
    "        population += 500 * np.exp(-10 * dist)\n",
    "    \n",
    "    # Add random rural population\n",
    "    population += np.random.exponential(20, (height, width))\n",
    "    \n",
    "    # Save as GeoTIFF\n",
    "    from rasterio.transform import from_bounds\n",
    "    from rasterio.crs import CRS\n",
    "    \n",
    "    transform = from_bounds(min_lon, min_lat, max_lon, max_lat, width, height)\n",
    "    \n",
    "    with rasterio.open(\n",
    "        'zambia_population_density.tif',\n",
    "        'w',\n",
    "        driver='GTiff',\n",
    "        height=height,\n",
    "        width=width,\n",
    "        count=1,\n",
    "        dtype=population.dtype,\n",
    "        crs=CRS.from_epsg(4326),\n",
    "        transform=transform,\n",
    "    ) as dst:\n",
    "        dst.write(population, 1)\n",
    "    \n",
    "    print(\"Synthetic population density data created: zambia_population_density.tif\")\n",
    "\n",
    "# Download or create population data\n",
    "population_file = download_worldpop_data()"
   ]
  },
