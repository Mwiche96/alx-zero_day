    "## Step 4: Create 10km Buffer Zones Around Substations\n",
    "\n",
    "Creating buffer zones to analyze energy access proximity."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_substation_buffers(substations, buffer_distance_km=10):\n",
    "    \"\"\"\n",
    "    Create buffer zones around substations.\n",
    "    \n",
    "    Args:\n",
    "        substations: GeoDataFrame of substation points\n",
    "        buffer_distance_km: Buffer distance in kilometers\n",
    "    \n",
    "    Returns:\n",
    "        GeoDataFrame with buffer polygons\n",
    "    \"\"\"\n",
    "    print(f\"Creating {buffer_distance_km}km buffer zones around substations...\")\n",
    "    \n",
    "    # Convert to a projected CRS for accurate distance calculations\n",
    "    # Using UTM Zone 35S for Zambia\n",
    "    substations_utm = substations.to_crs('EPSG:32735')\n",
    "    \n",
    "    # Create buffers (distance in meters)\n",
    "    buffer_distance_m = buffer_distance_km * 1000\n",
    "    buffers = substations_utm.copy()\n",
    "    buffers['geometry'] = substations_utm.geometry.buffer(buffer_distance_m)\n",
    "    \n",
    "    # Convert back to WGS84\n",
    "    buffers = buffers.to_crs('EPSG:4326')\n",
    "    \n",
    "    print(f\"Created {len(buffers)} buffer zones\")\n",
    "    return buffers\n",
    "\n",
    "# Create 10km buffer zones\n",
    "substation_buffers = create_substation_buffers(substations, 10)\n",
    "\n",
    "# Calculate total area covered by buffers\n",
    "buffers_utm = substation_buffers.to_crs('EPSG:32735')\n",
    "total_buffer_area = buffers_utm.geometry.area.sum() / 1e6  # Convert to km²\n",
    "print(f\"Total area covered by 10km buffers: {total_buffer_area:.2f} km²\")"
   ]
  },
  {
   "cell_type": "markdown",
