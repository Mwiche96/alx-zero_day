   "source": [
    "def get_substations():\n",
    "    \"\"\"\n",
    "    Extract substations from OpenStreetMap for Zambia using Overpass API.\n",
    "    \"\"\"\n",
    "    print(\"Extracting substations from OpenStreetMap...\")\n",
    "    \n",
    "    api = overpy.Overpass()\n",
    "    \n",
    "    # Overpass query for substations in Zambia\n",
    "    query = \"\"\"\n",
    "    [out:json][timeout:60];\n",
    "    (\n",
    "        node[\"power\"=\"substation\"](bbox:-18.5,21.5,-8.5,34.0);\n",
    "        way[\"power\"=\"substation\"](bbox:-18.5,21.5,-8.5,34.0);\n",
    "    );\n",
    "    out center;\n",
    "    \"\"\"\n",
    "    \n",
    "    try:\n",
    "        result = api.query(query)\n",
    "        print(f\"Found {len(result.nodes)} node substations and {len(result.ways)} way substations\")\n",
    "        \n",
    "        # Convert to GeoDataFrame\n",
    "        substations_data = []\n",
    "        \n",
    "        # Add node substations\n",
    "        for node in result.nodes:\n",
    "            substations_data.append({\n",
    "                'geometry': Point(node.lon, node.lat),\n",
    "                'id': node.id,\n",
    "                'name': node.tags.get('name', f'Substation_{node.id}'),\n",
    "                'voltage': node.tags.get('voltage', 'unknown')\n",
    "            })\n",
    "        \n",
    "        # Add way substations (use centroid)\n",
    "        for way in result.ways:\n",
    "            if way.nodes:\n",
    "                lons = [node.lon for node in way.nodes]\n",
    "                lats = [node.lat for node in way.nodes]\n",
    "                center_lon = sum(lons) / len(lons)\n",
    "                center_lat = sum(lats) / len(lats)\n",
    "                \n",
    "                substations_data.append({\n",
    "                    'geometry': Point(center_lon, center_lat),\n",
    "                    'id': way.id,\n",
    "                    'name': way.tags.get('name', f'Substation_{way.id}'),\n",
    "                    'voltage': way.tags.get('voltage', 'unknown')\n",
    "                })\n",
    "        \n",
    "        if substations_data:\n",
    "            gdf_substations = gpd.GeoDataFrame(substations_data, crs='EPSG:4326')\n",
    "            print(f\"Created GeoDataFrame with {len(gdf_substations)} substations\")\n",
    "            return gdf_substations\n",
    "        else:\n",
    "            print(\"No substations found, creating sample data...\")\n",
    "            return create_sample_substations()\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"Error querying OpenStreetMap: {e}\")\n",
    "        print(\"Creating sample substations data...\")\n",
    "        return create_sample_substations()\n",
    "\n",
    "def create_sample_substations():\n",
    "    \"\"\"\n",
    "    Create sample substations data for demonstration.\n",
    "    \"\"\"\n",
    "    print(\"Creating sample substations...\")\n",
    "    \n",
    "    # Sample substations in major Zambian cities and strategic locations\n",
    "    substations_data = [\n",
    "        {'geometry': Point(28.28, -15.41), 'name': 'Lusaka Central', 'voltage': '330/132', 'id': 1},\n",
    "        {'geometry': Point(28.22, -12.97), 'name': 'Kitwe Main', 'voltage': '220/132', 'id': 2},\n",
    "        {'geometry': Point(31.47, -12.84), 'name': 'Kasama', 'voltage': '132/33', 'id': 3},\n",
    "        {'geometry': Point(30.05, -14.78), 'name': 'Serenje', 'voltage': '220/88', 'id': 4},\n",
    "        {'geometry': Point(26.95, -14.29), 'name': 'Solwezi', 'voltage': '330/132', 'id': 5},\n",
    "        {'geometry': Point(25.85, -13.13), 'name': 'Mufumbwe', 'voltage': '132/33', 'id': 6},\n",
    "        {'geometry': Point(29.13, -13.54), 'name': 'Mpika', 'voltage': '132/33', 'id': 7},\n",
    "        {'geometry': Point(26.18, -17.87), 'name': 'Livingstone', 'voltage': '330/88', 'id': 8},\n",
    "        {'geometry': Point(24.75, -16.20), 'name': 'Senanga', 'voltage': '88/33', 'id': 9},\n",
    "        {'geometry': Point(29.82, -13.96), 'name': 'Chipata', 'voltage': '132/33', 'id': 10}\n",
    "    ]\n",
    "    \n",
    "    gdf_substations = gpd.GeoDataFrame(substations_data, crs='EPSG:4326')\n",
    "    print(f\"Created sample substations: {len(gdf_substations)} substations\")\n",
    "    return gdf_substations\n",
    "\n",
    "# Get substations data\n",
    "substations = get_substations()\n",
    "print(f\"\\nSubstation locations: {len(substations)} total\")\n",
    "print(substations[['name', 'voltage']].head())"
   ]
