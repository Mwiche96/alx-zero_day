    "## Step 7: Statistical Analysis\n",
    "\n",
    "Performing quantitative analysis of population density within and outside buffer zones."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_population_energy_access():\n",
    "    \"\"\"\n",
    "    Analyze population density within and outside substation buffer zones.\n",
    "    \"\"\"\n",
    "    print(\"Performing statistical analysis...\")\n",
    "    \n",
    "    # Load population data\n",
    "    with rasterio.open(population_file) as src:\n",
    "        population_data = src.read(1)\n",
    "        transform = src.transform\n",
    "        bounds = src.bounds\n",
    "        \n",
    "        # Create coordinate grids\n",
    "        height, width = population_data.shape\n",
    "        cols, rows = np.meshgrid(np.arange(width), np.arange(height))\n",
    "        xs, ys = rasterio.transform.xy(transform, rows, cols)\n",
    "        \n",
    "        # Convert to points\n",
    "        points = [Point(x, y) for x, y in zip(np.array(xs).flatten(), np.array(ys).flatten())]\n",
    "        pop_values = population_data.flatten()\n",
    "        \n",
    "        # Create GeoDataFrame of population points\n",
    "        pop_gdf = gpd.GeoDataFrame({\n",
    "            'population': pop_values,\n",
    "            'geometry': points\n",
    "        }, crs='EPSG:4326')\n",
    "        \n",
    "        # Remove zero population areas for cleaner analysis\n",
    "        pop_gdf = pop_gdf[pop_gdf['population'] > 0]\n",
    "    \n",
    "    # Combine all buffer zones into a single geometry\n",
    "    buffer_union = substation_buffers.geometry.unary_union\n",
    "    \n",
    "    # Check which population points are within buffer zones\n",
    "    print(\"Calculating population within buffer zones...\")\n",
    "    pop_gdf['within_buffer'] = pop_gdf.geometry.within(buffer_union)\n",
    "    \n",
    "    # Calculate statistics\n",
    "    total_population = pop_gdf['population'].sum()\n",
    "    pop_within_buffer = pop_gdf[pop_gdf['within_buffer']]['population'].sum()\n",
    "    pop_outside_buffer = pop_gdf[~pop_gdf['within_buffer']]['population'].sum()\n",
    "    \n",
    "    percent_within = (pop_within_buffer / total_population) * 100\n",
    "    percent_outside = (pop_outside_buffer / total_population) * 100\n",
    "    \n",
    "    # Calculate average population density\n",
    "    avg_density_within = pop_gdf[pop_gdf['within_buffer']]['population'].mean()\n",
    "    avg_density_outside = pop_gdf[~pop_gdf['within_buffer']]['population'].mean()\n",
    "    \n",
    "    # Print results\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"POPULATION DENSITY vs ENERGY ACCESS ANALYSIS\")\n",
    "    print(\"=\"*60)\n",
    "    print(f\"Total population analyzed: {total_population:,.0f}\")\n",
    "    print(f\"Number of substations: {len(substations)}\")\n",
    "    print(f\"Buffer zone distance: 10 km\")\n",
    "    print(\"\\nPOPULATION DISTRIBUTION:\")\n",
    "    print(f\"  Within 10km of substations: {pop_within_buffer:,.0f} ({percent_within:.1f}%)\")\n",
    "    print(f\"  Outside 10km of substations: {pop_outside_buffer:,.0f} ({percent_outside:.1f}%)\")\n",
    "    print(\"\\nAVERAGE POPULATION DENSITY:\")\n",
    "    print(f\"  Within buffer zones: {avg_density_within:.1f} people/km²\")\n",
    "    print(f\"  Outside buffer zones: {avg_density_outside:.1f} people/km²\")\n",
    "    \n",
    "    # Energy access ratio\n",
    "    if avg_density_outside > 0:\n",
    "        access_ratio = avg_density_within / avg_density_outside\n",
    "        print(f\"\\nENERGY ACCESS INDICATOR:\")\n",
    "        print(f\"  Density ratio (within/outside): {access_ratio:.2f}\")\n",
    "        if access_ratio > 1.5:\n",
    "            print(\"  → Higher population density near substations (good energy access)\")\n",
    "        elif access_ratio < 0.7:\n",
    "            print(\"  → Lower population density near substations (potential access gaps)\")\n",
    "        else:\n",
    "            print(\"  → Relatively balanced distribution\")\n",
    "    \n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    return {\n",
    "        'total_population': total_population,\n",
    "        'pop_within_buffer': pop_within_buffer,\n",
    "        'pop_outside_buffer': pop_outside_buffer,\n",
    "        'percent_within': percent_within,\n",
    "        'percent_outside': percent_outside,\n",
    "        'avg_density_within': avg_density_within,\n",
    "        'avg_density_outside': avg_density_outside\n",
    "    }\n",
    "\n",
    "# Perform analysis\n",
    "analysis_results = analyze_population_energy_access()"
   ]
