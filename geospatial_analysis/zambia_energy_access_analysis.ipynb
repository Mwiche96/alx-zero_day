    "def create_layered_visualization():\n",
    "    \"\"\"\n",
    "    Create the main layered visualization with all components.\n",
    "    \"\"\"\n",
    "    print(\"Creating layered visualization...\")\n",
    "    \n",
    "    # Set up the figure with high DPI for better quality\n",
    "    fig, ax = plt.subplots(1, 1, figsize=(16, 12), dpi=150)\n",
    "    \n",
    "    # Load and display population density (base layer)\n",
    "    print(\"Loading population density layer...\")\n",
    "    with rasterio.open(population_file) as src:\n",
    "        population_data = src.read(1)\n",
    "        population_extent = [src.bounds.left, src.bounds.right, \n",
    "                           src.bounds.bottom, src.bounds.top]\n",
    "        \n",
    "        # Create custom colormap for population density (light theme)\n",
    "        colors_pop = ['#FFFFFF', '#FFF5E6', '#FFE6CC', '#FFD1A3', \n",
    "                      '#FFBC7A', '#FFA751', '#FF9228', '#FF7D00', \n",
    "                      '#E6700A', '#CC6314', '#B3561E']\n",
